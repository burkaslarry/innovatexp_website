{
  "git": { "deploymentEnabled": { "codex/conversion-stripe-payments": false } },
  "installCommand": "npm ci",
  "crons": [{ "path": "/api/commerce/cron", "schedule": "0 1 * * *" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "innovatexp.co" }],
      "destination": "https://www.innovatexp.co/:path*",
      "permanent": true
    }
  ]
}
